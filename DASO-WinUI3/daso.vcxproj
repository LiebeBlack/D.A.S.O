<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="17.0"
         xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!--
    D.A.S.O Nativo - aplicacion WinUI 3.

    Dos decisiones que condicionan este fichero:

    1. /std:c++26preview y SIN /ZW.
       C++/WinRT (que exige /ZW) solo llega hasta C++17. Para poder compilar
       con C++26 se usa C++/WinRT en modo solo-cabecero: prefijo winrt:: y
       winrt::implements, sin proyeccion de lenguaje. Por eso el proyecto NO
       activa <CompileAsWinRT> ni incluye ningun .xaml, de modo que el
       compilador de XAML nunca se invoca.

    2. Despliegue unpackaged + self-contained.
       Se obtiene una carpeta copiable sin firma MSIX ni instalador de runtime.
       Por eso <WindowsPackageType> es None y <WindowsAppSDKSelfContained> true.
  -->

  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration><Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration><Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{7B3F1E2A-9C4D-4A6E-8B21-5D0C7E9F3A18}</ProjectGuid>
    <RootNamespace>dasoui</RootNamespace>
    <ProjectName>daso</ProjectName>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <!--
      Sin /ZW y sin XAML: este proyecto no es un "WinRT project".

      ApplicationType NO se declara. Poner "Windows Store" le dice a NuGet que
      la app es UWP y exige el framework UAP,Version=v10.0, que es
      precisamente lo que un despliegue unpackaged no puede enlazar:
        error : Your project does not reference "UAP,Version=v10.0" framework.

      Para una app de escritorio portable la ausencia de ApplicationType es lo
      correcto, no una omision.
    -->
    <AppContainerApplication>false</AppContainerApplication>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
    <WholeProgramOptimization Condition="'$(Configuration)'=='Release'">true</WholeProgramOptimization>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <PropertyGroup>
    <!-- Despliegue sin paquete: carpeta portable. -->
    <WindowsPackageType>None</WindowsPackageType>
    <AppxPackage>false</AppxPackage>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsAppSdkUndockedRegFreeWinRTInitialize>true</WindowsAppSdkUndockedRegFreeWinRTInitialize>
    <SelfContained>true</SelfContained>
    <!-- Nombre del ejecutable produced, sin espacios. -->
    <TargetName>daso</TargetName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <!-- 3.0.x: la linea con soporte de modulos y C++20/23 mas alla de la 2.0. -->
    <PackageReference Include="Microsoft.Windows.CppWinRT" Version="3.0.260818.1" />
  </ItemGroup>

  <ItemGroup>
    <!--
      NuGet necesita un moniker de destino para resolver los paquetes. El
      error original decia exactamente esto:

        Add a reference to "UAP,Version=v10.0" in the "TargetFrameworks" property

      Y este otro ("Sequence contains no elements" en GiveErrorForMissingFramework)
      lo provoco yo al anadir <FrameworkReference Remove="UAP" />: al quitar
      TODOS los framework references, NuGet se queda sin lista de donde elegir
      el destino y revienta al intentar reportar el problema.

      Se declara el moniker y no se quita ninguna referencia.
    -->
    <FrameworkReference Include="Windows Universal" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFrameworks>UAP;Windows</TargetFrameworks>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp26preview</LanguageStandard>
      <ConformanceMode>true</ConformanceMode>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>false</TreatWarningAsError>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <SDLCheck>true</SDLCheck>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <!-- /utf-8 es obligatorio: los textos es/en del catalogo son UTF-8. -->
      <AdditionalOptions>/utf-8 /Zc:__cplusplus %(AdditionalOptions)</AdditionalOptions>
      <AdditionalIncludeDirectories>$(ProjectDir)src\core\include;$(ProjectDir)src\platform\include;$(ProjectDir)src\ui\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <AdditionalDependencies>windowsapp.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <Manifest>
      <AdditionalManifestElements>
        <!-- asInvoker: D.A.S.O NUNCA pide administrador. -->
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </AdditionalManifestElements>
    </Manifest>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- El nucleo ya se comprueba con ctest; aqui interesa tamano y velocidad. -->
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
      <LinkTimeCodeGeneration>UseLinkTimeCodeGeneration</LinkTimeCodeGeneration>
    </Link>
  </ItemDefinitionGroup>

  <!-- Nucleo (ISO puro, sin WinSDK) -->
  <ItemGroup>
    <ClCompile Include="src\core\src\catalog.cpp" />
    <ClCompile Include="src\core\src\filter.cpp" />
    <ClCompile Include="src\core\src\log_buffer.cpp" />
    <ClCompile Include="src\core\src\manifest.cpp" />
    <ClCompile Include="src\core\src\plan.cpp" />
  </ItemGroup>

  <!-- Capa Win32 -->
  <ItemGroup>
    <ClCompile Include="src\platform\src\process.cpp" />
    <ClCompile Include="src\platform\src\adb.cpp" />
    <ClCompile Include="src\platform\src\manifest_store.cpp" />
  </ItemGroup>

  <!-- Capa WinUI 3 (sin XAML) -->
  <ItemGroup>
    <ClCompile Include="src\ui\src\ui_common.cpp" />
    <ClCompile Include="src\ui\src\main_window.cpp" />
    <ClCompile Include="src\app\main.cpp" />
  </ItemGroup>

  <ItemGroup>
    <ClInclude Include="src\core\include\daso\catalog.hpp" />
    <ClInclude Include="src\core\include\daso\catalog_data.hpp" />
    <ClInclude Include="src\core\include\daso\cancel.hpp" />
    <ClInclude Include="src\core\include\daso\filter.hpp" />
    <ClInclude Include="src\core\include\daso\log_buffer.hpp" />
    <ClInclude Include="src\core\include\daso\manifest.hpp" />
    <ClInclude Include="src\core\include\daso\plan.hpp" />
    <ClInclude Include="src\platform\include\daso\adb.hpp" />
    <ClInclude Include="src\platform\include\daso\process.hpp" />
    <ClInclude Include="src\platform\include\daso\manifest_store.hpp" />
    <ClInclude Include="src\platform\include\daso\manifest_store.hpp" />
    <ClInclude Include="src\ui\include\daso\ui\ui_common.hpp" />
    <ClInclude Include="src\ui\include\daso\ui\main_window.hpp" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />

  <Target Name="EnsureNoXaml" BeforeTargets="PrepareForBuild">
    <!-- Comprobacion de que nadie ha metido un .xaml: romperia /ZW. -->
    <Error Condition="'@(Xaml)' != ''"
           Text="Se ha anadido un fichero XAML. Esta compilacion usa C++26 sin /ZW: el arbol visual se construye en C++, en src/ui/src/main_window.cpp. Ver el comentario de cabecera." />
  </Target>
</Project>
